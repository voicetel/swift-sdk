# VoiceTel Swift SDK — integration test environment.
#
# Copy this file to `.env` and fill in real credentials, then `source .env`
# before running `swift test --enable-code-coverage` to exercise the live
# integration tests under Tests/VoiceTelTests/IntegrationTests.swift.
#
# Without these variables the integration tests skip silently — unit tests
# still run unconditionally.

# Required: your VoiceTel account credentials.
VOICETEL_USERNAME=
VOICETEL_PASSWORD=

# Optional: override the API endpoint (defaults to https://api.voicetel.com).
# Useful when pointing at a staging environment.
# VOICETEL_BASE_URL=https://api.voicetel.com
